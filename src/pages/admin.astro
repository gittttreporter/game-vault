---
import Base from '../layouts/Base.astro';
---
<Base title="Admin · THE VAULT" active="admin">
  <section class="min-h-[70vh]">
    <h1 class="heading-font text-2xl font-black glow-magenta mb-1">⚙ ARCHIVIST CONSOLE</h1>
    <p class="text-xs text-[color:var(--color-ink-dim)] mb-6">restricted access · mutations are audit-logged by Supabase</p>

    <div id="guard-checking" class="py-16 text-center">
      <p class="heading-font text-sm glow-cyan animate-pulse">◈ verifying clearance…</p>
    </div>

    <div id="guard-denied" class="panel p-8 text-center hidden">
      <p class="glow-magenta heading-font text-sm">✖ CLEARANCE DENIED</p>
      <p class="mt-2 text-sm text-[color:var(--color-ink-dim)]">this console is restricted to the archivist account</p>
    </div>

    <div id="console" class="hidden">
      <div class="flex gap-2 mb-6 flex-wrap" role="tablist">
        <button class="btn btn-cyan" data-tab="games" id="tabbtn-games">◈ Games</button>
        <button class="btn" data-tab="versions" id="tabbtn-versions">◇ Versions & Files</button>
        <button class="btn" data-tab="logs" id="tabbtn-logs">▤ Download Logs</button>
      </div>

      <!-- ═══ GAMES TAB ═══ -->
      <div id="tab-games" class="grid gap-6 lg:grid-cols-[20rem_1fr] items-start">
        <div class="panel p-4">
          <div class="flex items-center justify-between mb-3">
            <h2 class="heading-font text-xs tracking-widest text-[color:var(--color-ink-dim)]">CATALOG</h2>
            <button id="btn-new-game" class="btn btn-sm btn-cyan">＋ new</button>
          </div>
          <ul id="game-list" class="space-y-1 max-h-[32rem] overflow-y-auto"></ul>
        </div>
        <div class="panel panel-brass p-5">
          <h2 id="game-form-title" class="heading-font text-sm glow-cyan mb-4">NEW GAME</h2>
          <form id="game-form" class="space-y-3">
            <div class="grid gap-3 sm:grid-cols-2">
              <div><label class="lbl" for="g-title">Title *</label><input class="input" id="g-title" required /></div>
              <div><label class="lbl" for="g-slug">Slug (auto, editable)</label><input class="input" id="g-slug" placeholder="auto-from-title" /></div>
            </div>
            <div><label class="lbl" for="g-desc">Description</label><textarea class="input" id="g-desc" rows="5"></textarea></div>
            <div>
              <label class="lbl">Platforms</label>
              <div class="flex gap-4 flex-wrap" id="g-platforms">
                <label class="text-sm"><input type="checkbox" value="windows" /> Windows</label>
                <label class="text-sm"><input type="checkbox" value="linux" /> Linux</label>
                <label class="text-sm"><input type="checkbox" value="macos" /> macOS</label>
                <label class="text-sm"><input type="checkbox" value="android" /> Android</label>
              </div>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <div><label class="lbl" for="g-itch">itch.io URL</label><input class="input" id="g-itch" type="url" placeholder="https://…" /></div>
              <div><label class="lbl" for="g-steam">Steam URL</label><input class="input" id="g-steam" type="url" placeholder="https://…" /></div>
              <div><label class="lbl" for="g-trailer">Trailer URL</label><input class="input" id="g-trailer" type="url" placeholder="https://…" /></div>
              <div><label class="lbl" for="g-cover-url">Cover URL (or upload ↓)</label><input class="input" id="g-cover-url" type="url" /></div>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <label class="lbl" for="g-cover-file">Upload cover → Supabase Storage</label>
                <input class="input" id="g-cover-file" type="file" accept="image/*" />
              </div>
              <div>
                <label class="lbl" for="g-shots">Screenshots (one URL per line)</label>
                <textarea class="input" id="g-shots" rows="2" placeholder="https://…&#10;https://…"></textarea>
              </div>
            </div>
            <div>
              <label class="lbl" for="g-tag-input">Tags (autocomplete from existing)</label>
              <div id="g-tag-chips" class="flex flex-wrap gap-1.5 mb-1"></div>
              <input class="input" id="g-tag-input" list="tag-datalist" placeholder="type a tag and press Enter…" autocomplete="off" />
              <datalist id="tag-datalist"></datalist>
            </div>
            <div class="flex gap-2 pt-2">
              <button type="submit" class="btn btn-cyan" id="g-save">⌘ Save game</button>
              <button type="button" class="btn" id="g-reset">clear</button>
            </div>
          </form>
        </div>
      </div>

      <!-- ═══ VERSIONS & FILES TAB ═══ -->
      <div id="tab-versions" class="hidden space-y-4">
        <div class="panel panel-brass p-4 flex flex-wrap items-center gap-3">
          <label class="lbl mb-0">Game:</label>
          <select id="v-game" class="input max-w-sm"></select>
          <button id="btn-new-version" class="btn btn-sm btn-cyan">＋ new version</button>
        </div>
        <div id="version-editor" class="panel panel-brass p-5 hidden">
          <h2 id="version-form-title" class="heading-font text-sm glow-cyan mb-4">NEW VERSION</h2>
          <form id="version-form" class="grid gap-3 sm:grid-cols-[10rem_12rem_1fr] items-end">
            <div><label class="lbl" for="v-string">Version *</label><input class="input" id="v-string" required placeholder="1.2.0" /></div>
            <div><label class="lbl" for="v-date">Release date</label><input class="input" id="v-date" type="date" /></div>
            <div><label class="lbl" for="v-changelog">Changelog (markdown)</label><textarea class="input" id="v-changelog" rows="2" placeholder="- fixed the thing"></textarea></div>
            <div class="flex gap-2 sm:col-span-3">
              <button type="submit" class="btn btn-cyan">⌘ Save version</button>
              <button type="button" class="btn" id="v-reset">clear</button>
            </div>
          </form>
        </div>
        <div id="versions-list" class="space-y-4"></div>
      </div>

      <!-- ═══ LOGS TAB ═══ -->
      <div id="tab-logs" class="hidden">
        <div class="panel p-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="heading-font text-[10px] uppercase tracking-widest text-[color:var(--color-ink-dim)] text-left border-b border-[color:var(--color-line)]">
                <th class="py-2 pr-4">When</th><th class="pr-4">Operator</th><th class="pr-4">Game</th>
                <th class="pr-4">Version</th><th class="pr-4">Platform</th><th class="pr-4">Provider</th><th>Size</th>
              </tr>
            </thead>
            <tbody id="logs-body"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/admin.js';
</script>

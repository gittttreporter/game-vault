---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Login · THE VAULT" active="login">
  <div class="flex min-h-[70vh] items-center justify-center">
    <section class="panel panel-brass flicker-in w-full max-w-md p-8">
      <div class="mb-6 text-center">
        <svg class="spin-slow mx-auto w-12 h-12 mb-3" viewBox="0 0 64 64" aria-hidden="true">
          <g fill="none" stroke-width="3">
            <circle cx="32" cy="32" r="22" stroke="#c9a227" />
            <circle cx="32" cy="32" r="9" stroke="#ff2bd6" />
            <circle cx="32" cy="32" r="3" fill="#00e5ff" />
            <g stroke="#c9a227"><path d="M32 6v8M32 50v8M6 32h8M50 32h8M14 14l6 6M50 14l-6 6M14 50l6-6M50 50l-6-6"/></g>
          </g>
        </svg>
        <h1 class="heading-font text-xl font-bold glow-cyan">ACCESS TERMINAL</h1>
        <p class="mt-1 text-xs text-[color:var(--color-ink-dim)]">authorized personnel only · credentials issued by the archivist</p>
      </div>

      <form id="login-form" class="space-y-4">
        <div>
          <label class="lbl" for="email">Operator ID (email)</label>
          <input class="input" id="email" type="email" autocomplete="email" required placeholder="you@example.com" />
        </div>
        <div>
          <label class="lbl" for="password">Passphrase</label>
          <input class="input" id="password" type="password" autocomplete="current-password" required placeholder="••••••••••••" />
        </div>
        <p id="login-error" class="hidden text-sm text-[color:var(--color-neon-magenta)]" role="alert"></p>
        <button class="btn btn-cyan w-full" type="submit" id="login-btn">⏎ Authenticate</button>
      </form>

      <p class="mt-6 text-center text-xs text-[color:var(--color-ink-dim)]">
        no public sign-up — accounts are provisioned by the admin only
      </p>
    </section>
  </div>
</Base>

<script>
  import '../scripts/login.js';
</script>

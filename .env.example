# Copy this file to .env and fill in your values.
# These two are PUBLIC by design: they ship with the static site and are
# safe to expose (Supabase Row Level Security is what protects your data).
#
# Find them in: Supabase Dashboard → Project Settings → API

PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional — comments via Giscus (GitHub Discussions).
# Get the values at https://giscus.app after enabling Discussions on the
# *public* repo that hosts this site's code.
PUBLIC_GISCUS_REPO=YOURUSERNAME/YOURREPO
PUBLIC_GISCUS_REPO_ID=R_xxxxxxxxxxxxxxx
PUBLIC_GISCUS_CATEGORY_ID=DIC_yyyyyyyyyyyyyyy
